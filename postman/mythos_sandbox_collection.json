    {
      "name": "200: Partial character change",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Character was partially updated\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('desc');\r",
              "    pm.expect(jsonData.desc).to.eql('Бог только морей');\r",
              "});\r",
              "\r",
              "pm.test(\"Character ID remains unchanged\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    const expectedId = pm.collectionVariables.get('id');\r",
              "    pm.expect(jsonData.id).to.eql(parseInt(expectedId));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
